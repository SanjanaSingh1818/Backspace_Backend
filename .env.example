MONGO_URI=keep-existing-value
JWT_SECRET=replace-with-a-new-random-secret-at-least-32-characters
ADMIN_SECRET=replace-with-the-new-admin-secret
PORT=5000
FRONTEND_ORIGIN=https://your-frontend.example
RESET_URL=https://your-frontend.example/admin-reset-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=security@your-domain.example
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
